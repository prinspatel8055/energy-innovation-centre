# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and replace the values with your local/production settings.
# ==============================================================================

# PostgreSQL Database Connection URL
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/eic?schema=public"

# Admin CMS Credentials
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="your_secure_password"

# JWT Secret for Session Authentication (generate via `openssl rand -hex 32`)
JWT_SECRET="generate_a_secure_32_byte_hex_jwt_secret_here"

# Application Public Base URL
NEXT_PUBLIC_APP_URL="http://localhost:5000"
